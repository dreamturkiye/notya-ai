# ============================================================
# NOTYA AI - Ortam Değişkenleri
# Tüm değişkenleri .env.local dosyasına kopyalayın
# ============================================================

# ---- UYGULAMA ----
NEXT_PUBLIC_APP_URL=https://notya.ai
NODE_ENV=production

# ---- SUPABASE (EU Frankfurt) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- GROQ (Dr. Ayşe sandbox brain) ----
GROQ_API_KEY=gsk_...

# ---- ELEVENLABS (voice agents) ----
# Each persona uses a distinct Turkish voice (see lib/asistan/elevenVoices.ts).
# Defaults: Ayşe pediatri agent, Mehmet kardiyoloji, Elif TR nöroloji agent.
# ELEVENLABS_AGENT_PEDIATRI=agent_3601ktc884ntf3dbdkjtyx6vdfwa
# ELEVENLABS_AGENT_KARDIYOLOJI=agent_6501ktc87nmyeca88wskfvr8dfxh
# ELEVENLABS_AGENT_ELIF=agent_1301kwjdee1afajrqkdxmghna6sx
# ELEVENLABS_AGENT_NOROLOJI=
ELEVENLABS_API_KEY=...
# NOTYA-TEK-BEYIN-CORE-01: thin mouth (Custom LLM) is ON for every doctor + klinik by default.
# Kill switch: NOTYA_TEK_BEYIN_DOKTORLAR=off
# Optional allowlist (beta shape): NOTYA_TEK_BEYIN_DOKTORLAR=only:<uuid>,<uuid>
# NOTYA_TEK_BEYIN_DOKTORLAR=
# NOTYA_SES_LLM_SECRET=...   # ≥32 chars; same value on ElevenLabs Custom LLM agents
# NOTYA_SES_JETON_SECRET=... # ≥32 chars; signs voice tokens
# Ayşe default voice path is ElevenLabs. Set fish only to force the dormant Fish path.
# Free developer model until 30 Nov 2026. Never expose this to the browser.
# AYSE_SES_SAGLAYICI=elevenlabs
FISH_API_KEY=...
# Turkish native voice for Dr. Ayşe (Sibel Malkoç — verified tr-TR). Never use English Sarah/Jessica.
DR_AYSE_VOICE_ID=sMFjOtbPhx5GdIeKUBDN
# MALI_MUSAVIR_AGENT_ID=agent_4301kvraprgwf5btftn0k836t55m
# Optional per-avukat agent overrides (TR agents are hardcoded as fallbacks)
# AVUKAT_AGENT_KEMALBEY=
# AVUKAT_AGENT_SELINHANIM=
# AVUKAT_AGENT_MURATBEY=
# AVUKAT_AGENT_DILEKHANIM=
# AVUKAT_AGENT_HALUKBEY=
# AVUKAT_AGENT_AYSEHANIM=
# AVUKAT_AGENT_CANBEY=
# AVUKAT_AGENT_ZEYNEPHANIM=
# AVUKAT_AGENT_BORABEY=

# ---- DR. AYŞE SANDBOX (isolated pre-visit module) ----
SANDBOX_ENABLED=true
SANDBOX_ACCESS_TOKEN=dr-gokhan-beta-2026

# ---- ANTHROPIC (Claude API) ----
# Yalnız OPENROUTER_API_KEY boşken kullanılır (yerel/dev geri dönüşü) — NOTYA-MODEL-LUNA-01.
ANTHROPIC_API_KEY=sk-ant-...

# ---- OPENROUTER (LLM ödeme + taşıma — NOTYA-MODEL-LUNA-01, Kaan 2026-09-26) ----
# Doluysa HIZLI (GPT-6 Luna) ve GÜÇLÜ (Sonnet 5) ikisi de OpenRouter'dan gider; boşsa Anthropic doğrudan yolu.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NOTYA_OPENROUTER_APP_TITLE=Notya AI
NOTYA_OPENROUTER_APP_URL=https://notya.ai
# Model kademeleri (boşsa lib/ai/modeller.ts varsayılanları: openai/gpt-6-luna / anthropic/claude-sonnet-5).
# ACİL GERİ DÖNÜŞ (kill switch): NOTYA_MODEL_HIZLI=anthropic/claude-haiku-4.5 → HIZLI eski Haiku'ya döner, kod değişmez.
# NOTYA_MODEL_HIZLI=openai/gpt-6-luna
# NOTYA_MODEL_GUCLU=anthropic/claude-sonnet-5

# ---- DEEPGRAM (Türkçe Transkripsiyon) ----
DEEPGRAM_API_KEY=...
DEEPGRAM_PROJECT_ID=...

# ---- GÜVENLİK / ŞİFRELEME ----
# KVKK: Hasta kişisel verilerini şifrelemek için (min 32 karakter)
ENCRYPTION_MASTER_KEY=notya-kvkk-encryption-key-2026-secure-random
ENCRYPTION_SALT=notya-ai-kvkk-salt-2026
TC_HASH_PEPPER=notya-tc-kimlik-pepper-gizli-2026

# ---- İYZİCO (Türk Ödeme Sistemi) ----
IYZICO_API_KEY=sandbox-...
IYZICO_SECRET_KEY=sandbox-...
IYZICO_BASE_URL=https://api.iyzipay.com
# Plan kodları
IYZICO_PLAN_STARTER_MONTHLY=notya-starter-monthly
IYZICO_PLAN_STARTER_YEARLY=notya-starter-yearly
IYZICO_PLAN_PRO_MONTHLY=notya-pro-monthly
IYZICO_PLAN_PRO_YEARLY=notya-pro-yearly
IYZICO_PLAN_KLINIK_MONTHLY=notya-klinik-monthly
IYZICO_PLAN_KLINIK_YEARLY=notya-klinik-yearly

# ---- STRIPE (STRIPE-NOTYA-01, Kaan 2026-10-27) — Notya's OWN SaaS subscription, a doctor paying
# for the app itself. NOT lib/accounting/'s iyzico facilitators (a doctor billing their OWN
# patients) — unrelated. Today this is Kaan's shared StopThreatAI Stripe account
# (acct_1SX5XF2LZ4pKabuO), test mode; move to Notya's own dedicated account later by swapping
# these two keys plus the ten price IDs below — nothing else changes (lib/billing/stripePlans.ts).
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the Stripe Dashboard once the endpoint below is registered.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs — lib/billing/stripePlans.ts falls back to the live test-mode catalog created
# 2026-10-27 if these are unset, but set them explicitly once Notya has its own account.
# STRIPE_PRICE_METIN_ASISTAN_MONTH=price_...
# STRIPE_PRICE_METIN_ASISTAN_YEAR=price_...
# STRIPE_PRICE_SESLI_PRO_MONTH=price_...
# STRIPE_PRICE_SESLI_PRO_YEAR=price_...
# STRIPE_PRICE_MUAYENEHANE_MONTH=price_...
# STRIPE_PRICE_MUAYENEHANE_YEAR=price_...
# STRIPE_PRICE_KLINIK_TABAN_MONTH=price_...
# STRIPE_PRICE_KLINIK_TABAN_YEAR=price_...
# STRIPE_PRICE_KLINIK_KOLTUK_MONTH=price_...   # tiered volume price, quantity = seat count
# STRIPE_PRICE_KLINIK_KOLTUK_YEAR=price_...

# ---- WHATSAPP BUSINESS CLOUD API (Meta Embedded Signup, per-doctor numbers) ----
# Notya is a Meta Tech Provider: ONE Meta app serves every doctor; each doctor's own WABA / phone number / access token
# is stored encrypted per doctor in the database (doktor_whatsapp_baglantilari). There is NO global access token here.
# While any of the first four is missing the feature stays OFF (status API 503, card says "kurulum bekleniyor",
# webhook 503) — it never shows a fake "connected". Setup guide: docs/iletisim-kurulum-whatsapp.md
# Meta app id (public; the browser SDK needs it)
WHATSAPP_APP_ID=
# Meta app secret: webhook X-Hub-Signature-256 + code->token exchange. SERVER ONLY.
WHATSAPP_APP_SECRET=
# Embedded Signup configuration id (Meta app > WhatsApp > Embedded Signup)
WHATSAPP_ES_CONFIG_ID=
# any long random string; paste the SAME value in the Meta webhook setup
WHATSAPP_VERIFY_TOKEN=
# Webhook URL for the Meta app: https://www.notya.io/api/whatsapp/webhook  (subscribe: messages)
# Older names still work: META_APP_ID, META_APP_SECRET, META_ES_CONFIG_ID, WHATSAPP_WEBHOOK_VERIFY_TOKEN.
# Also needed (already used elsewhere): ENCRYPTION_MASTER_KEY, CRON_SECRET (hourly /api/cron/whatsapp-bakim),
# SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN + TELEGRAM_ADMIN_CHAT_ID (admin alerts: expired token, webhook failures).
# Legacy single-tenant variables kept ONLY for the unrelated Mali hatırlatma route (app/api/mali/hatirlatma reads
# WHATSAPP_BUSINESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID); the per-doctor WhatsApp feature never reads them:
# WHATSAPP_BUSINESS_TOKEN=EAAx...
# WHATSAPP_PHONE_NUMBER_ID=123456789

# ---- RESEND (E-posta) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=merhaba@notya.ai
RESEND_FROM_NAME=Notya AI

# ---- TELEGRAM (Admin Bildirimler) ----
TELEGRAM_BOT_TOKEN=...
TELEGRAM_ADMIN_CHAT_ID=5545242725

# ---- UPSTASH REDIS (Önbellek) ----
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ---- RATE LİMİT ----
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ---- NVI / KPS (doctor-owned credentials in vault; optional live SOAP) ----
# Leave unset for checksum-only + honest "not populated" until doctor NVI creds + live flag.
# NVI_KPS_LIVE=true
# NVI_KPS_SOAP_URL=https://tckimlik.nvi.gov.tr/Service/KPSPublic.asmx
# MERNIS_ENABLED=false
