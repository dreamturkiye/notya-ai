{
  "manifest_version": 3,
  "name": "Notya MBYS Yardımcısı",
  "short_name": "Notya MBYS",
  "version": "0.1.0",
  "description": "Notya'da hazırlanan muayene kaydını MBYS formundaki alanlara sizin tıklamanızla doldurur. Hiçbir MBYS düğmesine basmaz.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "arkaplan.js" },
  "externally_connectable": {
    "matches": ["https://notya.io/*", "https://www.notya.io/*"]
  },
  "content_scripts": [
    {
      "matches": ["https://mbys2.saglik.gov.tr/*"],
      "js": ["motor.js", "icerik.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
